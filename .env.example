KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/api/auth/creation
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_SITE_URL=http://localhost:3000

# KINDE_POST_LOGIN_REDIRECT_URL=https://airbnb-clone-bz.vercel.app/api/auth/creation
# KINDE_POST_LOGOUT_REDIRECT_URL=https://airbnb-clone-bz.vercel.app
# KINDE_SITE_URL=https://airbnb-clone-bz.vercel.app

KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=

# --- Kinde Management API (needed to delete users from Kinde, not just locally) ---
# 1. Kinde dashboard -> Settings -> APIs -> Machine to machine apps ->
#    register a new M2M app (or pick an existing one).
# 2. Open the app -> left menu -> "API" -> enable the Kinde Management API
#    and add your issuer URL (e.g. https://yourapp.kinde.com) to the
#    allowed audiences. This is what fixes the "audience ... has not been
#    whitelisted" error when fetching the M2M token.
# 3. On the same app -> "Permissions" -> grant `delete:users` on the user
#    resource. Without this, the DELETE /api/v1/user call returns 403.
# 4. Copy the M2M app's Client ID and Client Secret below.
# If these stay empty, /admin/users -> Delete still removes the local DB row
# and Supabase storage, but the Kinde account has to be removed by hand.
KINDE_MANAGEMENT_CLIENT_ID=
KINDE_MANAGEMENT_CLIENT_SECRET=
# Optional. Defaults to KINDE_ISSUER_URL. Some Kinde setups whitelist
# "<issuer>/api/v1" instead — set it here in that case.
# KINDE_MANAGEMENT_AUDIENCE=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=
